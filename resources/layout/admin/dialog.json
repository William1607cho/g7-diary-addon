{
  "comment": "In-screen confirm box (no browser confirm/alert — spec 4-1): leaving a tab or the screen with unsaved changes, deleting a category (its posts show the default category) or a weather (its posts show no weather). Data is never changed by the delete itself; the tab's save writes it.",
  "type": "basic",
  "name": "Div",
  "if": "{{!!_local.g7da?.dialog}}",
  "props": { "className": "g7da-adm-layer" },
  "children": [
    { "type": "basic", "name": "Div", "props": { "className": "g7da-adm-backdrop", "aria-hidden": "true" }, "actions": [{ "type": "click", "handler": "g7-diary-addon.admin", "params": { "op": "dialogCancel" } }] },
    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "g7da-adm-dialog", "role": "alertdialog", "aria-modal": "true", "aria-labelledby": "g7da-adm-dialog-title", "aria-describedby": "g7da-adm-dialog-text", "data-testid": "g7da-adm-dialog" },
      "children": [
        { "type": "basic", "name": "H2", "props": { "id": "g7da-adm-dialog-title", "className": "g7da-adm-dialog-title" }, "text": "{{['leave_tab', 'leave_page'].includes(_local.g7da?.dialog?.kind) ? $t('g7-diary-addon.admin.leave_title') : $t('g7-diary-addon.admin.delete_title')}}" },
        {
          "type": "basic",
          "name": "P",
          "props": { "id": "g7da-adm-dialog-text", "className": "g7da-adm-dialog-text", "data-testid": "g7da-adm-dialog-text" },
          "text": "{{_local.g7da?.dialog?.kind === 'delete_cat' ? $t('g7-diary-addon.admin.delete_cat_text', {name: _local.g7da?.dialog?.name, count: _local.g7da?.dialog?.count, base: _local.g7da?.dialog?.defaultName}) : (_local.g7da?.dialog?.kind === 'delete_weather' ? $t('g7-diary-addon.admin.delete_weather_text', {name: _local.g7da?.dialog?.name, count: _local.g7da?.dialog?.count}) : $t('g7-diary-addon.admin.leave_text'))}}"
        },
        { "type": "basic", "name": "P", "if": "{{['delete_cat', 'delete_weather'].includes(_local.g7da?.dialog?.kind)}}", "props": { "className": "g7da-adm-hint" }, "text": "$t:g7-diary-addon.admin.delete_note" },
        {
          "type": "basic",
          "name": "Div",
          "props": { "className": "g7da-adm-dialog-actions" },
          "children": [
            { "type": "basic", "name": "Button", "props": { "type": "button", "className": "btn btn-secondary", "data-g7da-close": true, "data-g7da-autofocus": true, "data-testid": "g7da-adm-dialog-cancel" }, "actions": [{ "type": "click", "handler": "g7-diary-addon.admin", "params": { "op": "dialogCancel" } }], "text": "{{['leave_tab', 'leave_page'].includes(_local.g7da?.dialog?.kind) ? $t('g7-diary-addon.admin.keep_editing') : $t('g7-diary-addon.admin.cancel')}}" },
            { "type": "basic", "name": "Button", "props": { "type": "button", "className": "btn btn-danger g7da-adm-confirm", "data-testid": "g7da-adm-dialog-ok" }, "actions": [{ "type": "click", "handler": "g7-diary-addon.admin", "params": { "op": "dialogConfirm" } }], "text": "{{['leave_tab', 'leave_page'].includes(_local.g7da?.dialog?.kind) ? $t('g7-diary-addon.admin.leave_ok') : $t('g7-diary-addon.admin.delete_ok')}}" }
          ]
        }
      ]
    }
  ]
}
