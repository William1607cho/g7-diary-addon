{
  "comment": "One diary card. The title button is stretched over the whole card (CSS), so a click anywhere opens the post; links inside the preview stay plain <a> but do not take clicks in the list. No created time — only the diary date.",
  "type": "basic",
  "name": "Div",
  "props": {
    "className": "{{'g7da-card' + (post?.row_type === 'notice' ? ' is-pinned' : '') + (post?.deleted_at ? ' is-deleted' : '')}}",
    "data-g7da": "card"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "g7da-card-head" },
      "children": [
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.diary?.category}}",
          "props": {
            "className": "g7da-chip",
            "style": { "backgroundColor": "{{(post?.diary?.category?.color ?? '#9CA3AF') + '26'}}" }
          },
          "text": "{{post?.diary?.category?.emoji ?? ''}} {{post?.diary?.category?.name ?? ''}}"
        },
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.diary?.date_label}}",
          "props": { "className": "g7da-date" },
          "text": "{{post?.diary?.date_label ?? ''}}"
        },
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.diary?.weather}}",
          "props": {
            "className": "g7da-weather",
            "role": "img",
            "aria-label": "{{post?.diary?.weather?.label ?? ''}}",
            "data-g7da-tip": "{{post?.diary?.weather?.label ?? ''}}"
          },
          "text": "{{post?.diary?.weather?.emoji ?? ''}}"
        },
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.is_secret}}",
          "props": { "className": "g7da-secret" },
          "children": [
            { "type": "basic", "name": "Icon", "props": { "name": "lock", "size": "sm", "aria-hidden": "true" } },
            { "type": "basic", "name": "Span", "text": "$t:g7-diary-addon.secret" }
          ]
        },
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.deleted_at}}",
          "props": { "className": "g7da-deleted" },
          "text": "$t:g7-diary-addon.deleted"
        },
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.row_type === 'notice'}}",
          "props": { "className": "g7da-pin" },
          "text": "$t:g7-diary-addon.pinned"
        }
      ]
    },
    {
      "type": "basic",
      "name": "Button",
      "props": { "type": "button", "className": "g7da-card-title" },
      "actions": [
        {
          "type": "click",
          "handler": "navigate",
          "params": { "path": "/board/{{route?.slug}}/{{post?.id}}", "mergeQuery": true, "query": {} }
        }
      ],
      "text": "{{post?.title ?? ''}}"
    },
    {
      "type": "basic",
      "name": "Div",
      "if": "{{post?.diary_preview_html}}",
      "props": { "className": "{{'g7da-preview' + (post?.diary_preview_clipped ? ' is-clipped' : '')}}" },
      "children": [
        {
          "type": "composite",
          "name": "HtmlContent",
          "props": {
            "content": "{{post?.diary_preview_html ?? ''}}",
            "isHtml": true,
            "className": "g7da-preview-body"
          }
        }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "if": "{{posts?.data?.board?.settings?.use_comment}}",
      "props": { "className": "g7da-card-foot" },
      "children": [
        {
          "type": "basic",
          "name": "Span",
          "props": { "className": "g7da-comments" },
          "children": [
            { "type": "basic", "name": "Icon", "props": { "name": "comment", "size": "sm", "aria-hidden": "true" } },
            { "type": "basic", "name": "Span", "text": "{{post?.comment_count ?? 0}}" }
          ]
        }
      ]
    }
  ]
}
