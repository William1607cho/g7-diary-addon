{
  "comment": "One diary card (D65). The head line is the card link: category emoji, diary date, weather emoji, title (bold, one line, …), and at the right end the secret lock / pinned bullhorn. Wide screens: one line at 1.5x; narrow: emoji·date·weather·flags, then the title on its own line (CSS order). The link is stretched over the card (CSS ::after), so a click anywhere opens the post; the head items sit above that layer only for their tooltips. Then the text preview and the photo row (D64). No created time — only the diary date.",
  "type": "basic",
  "name": "Div",
  "props": {
    "className": "{{'g7da-card' + (post?.row_type === 'notice' ? ' is-pinned' : '') + (post?.deleted_at ? ' is-deleted' : '')}}",
    "data-g7da": "card"
  },
  "children": [
    {
      "type": "basic",
      "name": "Button",
      "props": { "type": "button", "className": "g7da-card-link" },
      "actions": [
        {
          "type": "click",
          "handler": "navigate",
          "params": { "path": "/board/{{route?.slug}}/{{post?.id}}", "mergeQuery": true, "query": {} }
        }
      ],
      "children": [
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.diary?.category}}",
          "props": {
            "className": "g7da-cat",
            "role": "img",
            "aria-label": "{{post?.diary?.category?.name ?? ''}}",
            "data-g7da-tip": "{{post?.diary?.category?.name ?? ''}}"
          },
          "text": "{{post?.diary?.category?.emoji ?? ''}}"
        },
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.diary?.date_label}}",
          "props": { "className": "g7da-date" },
          "text": "{{post?.diary?.date_label ?? ''}}"
        },
        {
          "type": "basic",
          "name": "Span",
          "if": "{{post?.diary?.weather}}",
          "props": {
            "className": "g7da-weather",
            "role": "img",
            "aria-label": "{{post?.diary?.weather?.label ?? ''}}",
            "data-g7da-tip": "{{post?.diary?.weather?.label ?? ''}}"
          },
          "text": "{{post?.diary?.weather?.emoji ?? ''}}"
        },
        {
          "type": "basic",
          "name": "Span",
          "props": { "className": "g7da-title-wrap", "data-g7da-tip": "{{post?.title ?? ''}}" },
          "children": [
            { "type": "basic", "name": "Span", "props": { "className": "g7da-title-text" }, "text": "{{post?.title ?? ''}}" }
          ]
        },
        { "g7da_include": "index/card-flags" }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "if": "{{post?.diary_preview_html}}",
      "props": { "className": "{{'g7da-preview' + (post?.diary_preview_clipped ? ' is-clipped' : '')}}" },
      "children": [
        {
          "type": "composite",
          "name": "HtmlContent",
          "props": {
            "content": "{{post?.diary_preview_html ?? ''}}",
            "isHtml": true,
            "className": "g7da-preview-body"
          }
        }
      ]
    },
    { "g7da_include": "index/card-photos" },
    {
      "type": "basic",
      "name": "Div",
      "if": "{{posts?.data?.board?.settings?.use_comment}}",
      "props": { "className": "g7da-card-foot" },
      "children": [
        {
          "type": "basic",
          "name": "Span",
          "props": { "className": "g7da-comments" },
          "children": [
            { "type": "basic", "name": "Icon", "props": { "name": "comment", "size": "sm", "aria-hidden": "true" } },
            { "type": "basic", "name": "Span", "text": "{{post?.comment_count ?? 0}}" }
          ]
        }
      ]
    }
  ]
}
