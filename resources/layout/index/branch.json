{
  "id": "g7da_list_branch",
  "comment": "g7-diary-addon: diary list branch (D17, template not modified). Rendered only for diary boards; inserted next to the basic fallback branch, whose condition excludes diary.",
  "type": "basic",
  "name": "Div",
  "if": "{{posts?.data?.board?.type === 'diary'}}",
  "props": {
    "className": "g7da-list",
    "data-g7da": "list"
  },
  "lifecycle": {
    "onMount": [
      { "g7da_include": "common/summary-fetch" },
      {
        "comment": "Panel month calendar (wide screens): the month of the date filter, else this month.",
        "handler": "apiCall",
        "auth_mode": "optional",
        "target": "/api/plugins/g7-diary-addon/boards/{{route.slug}}/calendar",
        "params": { "method": "GET", "query": { "month": "{{query.diary_date ? String(query.diary_date).substring(0, 7) : ''}}" } },
        "onSuccess": [
          { "handler": "setState", "params": { "target": "local", "g7daPcal": "{{response.data}}" } }
        ]
      }
    ]
  },
  "children": [
    { "g7da_include": "index/header" },
    { "g7da_include": "index/search" },
    { "g7da_include": "index/mobile-categories" },
    { "g7da_include": "index/cards" },
    { "g7da_include": "index/empty" },
    { "g7da_include": "index/pager" },
    { "g7da_include": "index/panel" },
    { "g7da_include": "common/memories" }
  ]
}
