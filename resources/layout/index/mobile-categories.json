{
  "comment": "Narrow screens only (CSS): one centred row — 📖 All first, then category emoji cells on the category colour; names in tooltip and aria-label. Same rules as the panel (D67): All selected without a filter, a selected category stays selected. Emoji 120% (D68); 8 cells fit a 360px screen.",
  "type": "basic",
  "name": "Div",
  "if": "{{(_local.g7daSummary?.categories ?? []).length > 0}}",
  "props": {
    "className": "g7da-mcats",
    "role": "group",
    "aria-label": "$t:g7-diary-addon.category_filter"
  },
  "children": [
    {
      "type": "basic",
      "name": "Button",
      "props": {
        "type": "button",
        "className": "{{'g7da-mcat g7da-mcat--all' + (!query.diary_category ? ' is-on' : '')}}",
        "aria-label": "$t:g7-diary-addon.all",
        "aria-pressed": "{{!query.diary_category ? 'true' : 'false'}}",
        "data-g7da-tip": "$t:g7-diary-addon.all"
      },
      "actions": [
        {
          "type": "click",
          "handler": "navigate",
          "params": { "path": "/board/{{route.slug}}", "mergeQuery": true, "query": { "diary_category": "", "page": 1 } }
        }
      ],
      "children": [
        { "type": "basic", "name": "Span", "props": { "aria-hidden": "true" }, "text": "📖" }
      ]
    },
    {
      "type": "basic",
      "name": "Button",
      "iteration": { "source": "{{_local.g7daSummary?.categories ?? []}}", "item_var": "cat" },
      "props": {
        "type": "button",
        "className": "{{'g7da-mcat' + (query.diary_category == cat.id ? ' is-on' : '')}}",
        "style": { "backgroundColor": "{{cat.color + '33'}}" },
        "aria-label": "{{cat.name}}",
        "aria-pressed": "{{query.diary_category == cat.id ? 'true' : 'false'}}",
        "data-g7da-tip": "{{cat.name}}"
      },
      "actions": [
        {
          "type": "click",
          "handler": "navigate",
          "params": { "path": "/board/{{route.slug}}", "mergeQuery": true, "query": { "diary_category": "{{cat.id}}", "page": 1 } }
        }
      ],
      "children": [
        { "type": "basic", "name": "Span", "props": { "aria-hidden": "true" }, "text": "{{cat.emoji}}" }
      ]
    }
  ]
}
