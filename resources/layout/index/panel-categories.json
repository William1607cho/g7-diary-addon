{
  "comment": "Category buttons, 3 per row (3·3·2): first 'All' (📖, badge = all posts — existence counts, D6), then the categories (badge = posts the viewer may see the category of, D6). Fixed equal squares; name area always two lines (keep-all). Selected = orange border; 'All' is selected without a filter. Pressing a selected category keeps it — only 'All' clears the filter (D67).",
  "type": "basic",
  "name": "Div",
  "props": {
    "className": "g7da-pcats",
    "role": "group",
    "aria-label": "$t:g7-diary-addon.category_filter"
  },
  "children": [
    {
      "type": "basic",
      "name": "Button",
      "props": {
        "type": "button",
        "className": "{{'g7da-pcat g7da-pcat--all' + (!query.diary_category ? ' is-on' : '')}}",
        "aria-pressed": "{{!query.diary_category ? 'true' : 'false'}}",
        "aria-label": "{{$t('g7-diary-addon.all') + ' ' + (_local.g7daSummary?.total ?? 0)}}"
      },
      "actions": [
        {
          "type": "click",
          "handler": "navigate",
          "params": { "path": "/board/{{route.slug}}", "mergeQuery": true, "query": { "diary_category": "", "page": 1 } }
        }
      ],
      "children": [
        { "type": "basic", "name": "Span", "props": { "className": "g7da-pcat-emoji", "aria-hidden": "true" }, "text": "📖" },
        { "type": "basic", "name": "Span", "props": { "className": "g7da-pcat-name", "aria-hidden": "true" }, "text": "$t:g7-diary-addon.all" },
        { "type": "basic", "name": "Span", "props": { "className": "g7da-pcat-count", "aria-hidden": "true" }, "text": "{{_local.g7daSummary?.total ?? 0}}" }
      ]
    },
    {
      "type": "basic",
      "name": "Button",
      "iteration": { "source": "{{_local.g7daSummary?.categories ?? []}}", "item_var": "cat" },
      "props": {
        "type": "button",
        "className": "{{'g7da-pcat' + (query.diary_category == cat.id ? ' is-on' : '')}}",
        "style": { "backgroundColor": "{{cat.color + '1F'}}" },
        "aria-pressed": "{{query.diary_category == cat.id ? 'true' : 'false'}}",
        "aria-label": "{{cat.name + ' ' + cat.count}}"
      },
      "actions": [
        {
          "type": "click",
          "handler": "navigate",
          "params": { "path": "/board/{{route.slug}}", "mergeQuery": true, "query": { "diary_category": "{{cat.id}}", "page": 1 } }
        }
      ],
      "children": [
        { "type": "basic", "name": "Span", "props": { "className": "g7da-pcat-emoji", "aria-hidden": "true" }, "text": "{{cat.emoji}}" },
        { "type": "basic", "name": "Span", "props": { "className": "g7da-pcat-name", "aria-hidden": "true" }, "text": "{{cat.name}}" },
        { "type": "basic", "name": "Span", "props": { "className": "g7da-pcat-count", "aria-hidden": "true" }, "text": "{{cat.count}}" }
      ]
    }
  ]
}
